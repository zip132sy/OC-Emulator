# 统一换行符, 避免跨平台检出时脚本被破坏
* text=auto

# 脚本: sh 必须 LF, bat 必须 CRLF
*.sh   text eol=lf
*.bat  text eol=crlf

# 源码 / 文本: 一律 LF
*.js   text eol=lf
*.lua  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.hex  text eol=lf

# 无扩展名的文本文件: 同样固定为 LF。
# 所有文本文件都显式指定换行符后, 各平台检出的内容才完全一致,
# SHA256SUMS 里的哈希才能跨平台通用。
/.gitattributes text eol=lf
/.gitignore     text eol=lf
/LICENSE        text eol=lf
/SHA256SUMS     text eol=lf

# 二进制资源: 不做任何转换
*.ocd  binary
*.ocf  binary
*.ttf  binary
*.otf  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
