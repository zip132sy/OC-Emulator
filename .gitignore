# ============================================================
# OC Emulator - 版本控制忽略规则
# 只上传模拟器本体与必要资源; 文档 / 测试 / 调试 / 运行时数据不入库
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 运行时数据 ----------
# 运行日志
logs/
*.log
# 虚拟机实例数据 (首次运行会自动生成)
vms/
# Mods 设备数据 (由控制面板创建, 属于运行时数据)
Mods/
# 下载缓存 (软盘模板 / OpenOS 源码, 可由脚本重新生成)
cache/

# ---------- 本机配置 ----------
# 各人机器上的 Lua 路径 / 端口等本地设置, 由服务器首次运行时自动生成
settings.json

# ---------- 文档与调试资源 ----------
# 修改记录 / 计划 / 修复文档 (仅保留 README.md)
docs/
# 调试用截图与数据
assets/

# ---------- 本地工具脚本 (仅供本地使用, 不上传) ----------
scripts/

# ---------- 根目录遗留的调试文件 ----------
\!PS_SCRIPT!
/create-openos-disk.lua

# ---------- 编辑器 / 工具临时目录 ----------
.trae/
.trae-html-share-packages/
.vscode/
.idea/

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
*.tmp
*.bak
*~
